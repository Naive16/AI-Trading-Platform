{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trading Signal",
  "type": "object",
  "required": [
    "signalId",
    "symbol",
    "timeframe",
    "action",
    "confidence",
    "timestamp"
  ],
  "properties": {
    "signalId": {
      "type": "string",
      "format": "uuid"
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "timeframe": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "BUY",
        "SELL",
        "WAIT"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "entry": {
      "type": [
        "number",
        "null"
      ]
    },
    "stopLoss": {
      "type": [
        "number",
        "null"
      ]
    },
    "takeProfit": {
      "type": [
        "number",
        "null"
      ]
    },
    "riskPercent": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "strategy": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
